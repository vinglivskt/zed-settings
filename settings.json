{
  // ============================================================================
  // ОСНОВНЫЕ НАСТРОЙКИ РЕДАКТОРА
  // ============================================================================

  // Режим доступности — улучшает навигацию с клавиатуры и поддержку скринридеров.
  // Включите, если используете вспомогательные технологии или хотите улучшить
  // доступность интерфейса для всех участников команды.
  // По умолчанию: false
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "glm-acp-agent": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.4-mini"
      },
      "type": "registry"
    }
  },
  "accessible_mode": true,

  // Поведение Zed при запуске.
  // "last_session" — восстанавливает все окна и вкладки, которые были открыты при закрытии.
  // "last_workspace" — открывает только последнее workspace.
  // "empty_tab" — всегда начинает с пустого редактора.
  // "launchpad" — всегда начинает с страницы запуска.
  // Рекомендуется: "last_session" для продолжения работы с всех проектов.
  "restore_on_startup": "last_session",

  // Автоматически закрывать вкладки, когда соответствующие файлы удаляются с диска.
  // Особенно полезно для временных файлов, скриптов и файлов, создаваемых внешними процессами.
  // Внимание: файлы с несохранёнными изменениями НЕ будут закрываться автоматически.
  // По умолчанию: false
  "close_on_file_delete": true,

  // Настройки автоматического сохранения файлов.
  // "off" — отключить автосохранение.
  // "on_focus_change" — сохранять при смене фокуса окна или файла.
  // "on_window_change" — сохранять при смене активного окна.
  // "after_delay" — сохранять после периода бездействия (задаётся в миллисекундах).
  // Рекомендуется: after_delay с 1000ms для контроля над моментом сохранения.
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    },
  },

  // Форматировать ли файл при сохранении.
  // "on" — форматировать весь файл при сохранении.
  // "off" — не форматировать.
  // "modifications" — форматировать только изменённые строки (требует Git и поддержки LSP).
  // "modifications_if_available" — форматировать изменённые строки, с fallback на весь файл.
  // Рекомендуется: "modifications_if_available" для больших файлов и legacy-кода.
  "format_on_save": "modifications_if_available",

  // Гарантировать наличие переноса строки в конце файла при сохранении.
  // Удаляет лишние пустые строки в конце и добавляет один перенос, если его нет.
  // Предотвращает проблемы с Git-диффом и CI-пайплайнами.
  // По умолчанию: true
  "ensure_final_newline_on_save": true,

  // Удалять trailing whitespace (пробелы и табы в конце строк) при сохранении.
  // Поддерживает чистоту кода и предотвращает конфликты в Git.
  // По умолчанию: true
  "remove_trailing_whitespace_on_save": true,

  // Как обрабатывать окончания строк (line endings).
  // "detect" — определять автоматически на основе существующего файла.
  // "prefer_lf" — предпочитать LF (\n) для новых файлов.
  // "prefer_crlf" — предпочитать CRLF (\r\n) для новых файлов.
  // "enforce_lf" — всегда использовать LF при форматировании и сохранении.
  // "enforce_crlf" — всегда использовать CRLF при форматировании и сохранении.
  // Рекомендуется: "detect" для кроссплатформенной разработки.
  "line_ending": "detect",

  // Запрашивать подтверждение перед закрытием приложения с несохранёнными изменениями.
  // Предотвращает случайную потерю кода.
  // По умолчанию: false
  "confirm_quit": true,

  // Использовать нативные вкладки окон macOS для группировки окон Zed.
  // Только для macOS. Позволяет использовать системную настройку "Всегда/В полноэкранном/Никогда".
  // По умолчанию: false
  "use_system_window_tabs": true,

  // ============================================================================
  // PRETTIER
  // ============================================================================

  // Интеграция с Prettier — популярным форматтером для JavaScript/TypeScript/JSON.
  // "allowed": true — разрешить использование Prettier как форматтера.
  // Вложенные настройки Prettier:
  //   "singleQuote": true — использовать одинарные кавычки.
  //   "trailingComma": "all" — добавлять trailing commas везде, где это возможно.
  //   "printWidth": 100 — максимальная длина строки.
  //   "tabWidth": 2 — размер табуляции (2 пробела для JS/TS).
  "prettier": {
    "allowed": true,
    "prettier": {
      "singleQuote": true,
      "trailingComma": "all",
      "printWidth": 100,
      "tabWidth": 2
    }
  },

  // ============================================================================
  // DIRENV ИНТЕГРАЦИЯ
  // ============================================================================

  // Интеграция с direnv для загрузки переменных окружения из .envrc файлов.
  // "shell_hook" — использовать shell hook для загрузки (рекомендуется).
  // "direct" — использовать `direnv export json` напрямую.
  // "disabled" — отключить автоматическую загрузку.
  // Требует установленного direnv. Полезно для проектов с виртуальными окружениями.
  "load_direnv": "shell_hook",

  // ============================================================================
  // TOOLBAR (ПАНЕЛЬ ИНСТРУМЕНТОВ)
  // ============================================================================

  // Настройки панели инструментов редактора.
  // Каждая опция управляет отображением соответствующего элемента.
  // Если все элементы скрыты, панель не отображается.
  "toolbar": {
    // "breadcrumbs" — путь к текущему файлу в иерархии проекта.
    // Полезно для навигации по вложенным директориям.
    "breadcrumbs": true,

    // "quick_actions" — быстрые действия (создать файл, открыть папку и т.д.).
    "quick_actions": true,

    // "selections_menu" — меню для работы с несколькими выделениями.
    // Полезно для множественного редактирования.
    "selections_menu": true,

    // "agent_review" — обзор изменений, внесённых AI-агентом.
    // Показывает inline diff для правок агента.
    "agent_review": true,

    // "code_actions" — действия с кодом (быстрые исправления, рефакторинг).
    // Отображает световому мечу при наведении на проблемные участки.
    "code_actions": true
  },

  // ============================================================================
  // AI-АГЕНТ
  // ============================================================================

  // Настройки AI-ассистента Zed. Открывается через Cmd+Shift+A (macOS) или Ctrl+Shift+A (Linux/Windows).
  // Подробнее: https://zed.dev/docs/ai/agent-settings
  "agent": {
    // Позиция боковой панели агента: "left" или "right".
    // "right" — не мешает основному коду, удобно для широких экранов.
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "minimax/minimax-m3:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "poolside/laguna-s-2.1:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.2:free",
        "enable_thinking": true
      }
    ],
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "allow_unsandboxed": false
    },
    "sidebar_side": "right",

    // Позиция док-панели агента: "left", "right" или "bottom".
    "dock": "right",

    // Профиль агента по умолчанию при создании нового потока.
    // Доступные профили: "write", "review", "debug" (настраиваются ниже).
    "default_profile": "write",

    // Основная модель AI для сложной работы с кодом, рефакторинга, анализа проекта.
    // Используется в агент-панели для диалогов и выполнения задач.
    // "enable_thinking": true — включить режим цепочечного мышления (для моделей, поддерживающих его).
    // "provider": "anthropic" — провайдер модели (anthropic, openai, openrouter, ollama и др.).
    // "model": "claude-3-5-sonnet-20241022" — конкретная модель.
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "openrouter/free"
    },

    // Модель для inline-ассистента (быстрые правки, объяснение кода).
    // Активируется через Cmd+Enter (macOS) или Ctrl+Enter (Linux/Windows).
    // Используйте более быструю и лёгкую модель для inline-операций.
    "inline_assistant_model": {
      "enable_thinking": false,
      "provider": "openrouter",
      "model": "minimax/minimax-m2.7:free"
    },

    // Модель для кратких описаний в Git blame и thread summary.
    // Используется для генерации кратких описаний коммитов и сводок потоков.
    "thread_summary_model": {
      "enable_thinking": false,
      "provider": "openrouter",
      "model": "minimax/minimax-m2.7:free"
    },

    // Модель для генерации сообщений коммитов Git.
    // Активируется при создании коммита через агент-панель.
    "commit_message_model": {
      "enable_thinking": false,
      "provider": "openrouter",
      "model": "minimax/minimax-m2.7:free"
    },

    // Инструкции для генерации сообщений коммитов.
    // Используйте формат Conventional Commits для стандартизированных коммитов.
    // Пример: "feat(api): add user authentication endpoint"
    "commit_message_instructions": "Формат: <type>(<scope>): <description>. Пиши на русском языке, строчными буквами, без точки в конце. type: feat, fix, docs, style, refactor, test, chore. scope — по названию модуля или фичи. description — в прошедшем времени от первого лица единственного числа (добавил, исправил, обновил, убрал, перенес). Кратко, по факту, что конкретно сделано. Без инфинитивов, без воды, без домыслов. Если есть breaking changes — добавь строку: BREAKING CHANGE: <что изменилось и как мигрировать>.",

    // Уведомление при ожидании агента.
    // "primary_screen" — показывать на основном экране.
    // "all_screens" — показывать на всех экранах.
    // "never" — не показывать.
    "notify_when_agent_waiting": "primary_screen",

    // Звук при завершении работы агента.
    // "never" — не играть звук.
    // "when_hidden" — играть только когда Zed в фоновом режиме.
    // "always" — всегда играть.
    "play_sound_when_agent_done": "never",

    // Показывать inline diff для правок агента в активном буфере.
    // Позволяет быстро просматривть изменения, внесённые агентом.
    "single_file_review": true,

    // Профили агента — предустановленные конфигурации с ограничениями на инструменты.
    // Позволяют контролировать, какие действия может выполнять агент.
    "profiles": {
      // Профиль "Write Code" — полный доступ для написания и рефакторинга кода.
      "write": {
        "name": "Write Code",
        "tools": {
          "edit_file": true,
          "create_file": true,
          "delete_file": true,
          "rename_file": true,
          "find_file": true,
          "terminal": true,
          "search": true,
          "fetch": true,
          "run_command": true,
          "copy_path": true,
          "move_path": true,
          "open_file": true,
          "go_to_file": true,
          "set_context": true,
          "set_files": true,
          "spawn_agent": false,
          "create_task": false
        },
        "enable_all_context_servers": true
      },
      // Профиль "Code Review" — только чтение, без изменения файлов.
      "review": {
        "name": "Code Review",
        "tools": {
          "edit_file": false,
          "create_file": false,
          "delete_file": false,
          "rename_file": false,
          "find_file": true,
          "terminal": false,
          "search": true,
          "fetch": true,
          "run_command": false,
          "copy_path": true,
          "move_path": false,
          "open_file": true,
          "go_to_file": true,
          "set_context": true,
          "set_files": true,
          "spawn_agent": false,
          "create_task": false
        },
        "enable_all_context_servers": true,
        "default_model": {
          "provider": "openrouter",
          "model": "z-ai/glm-5.2:free"
        }
      },
      // Профиль "Debug" — доступ к терминалу и запуску команд для отладки.
      "debug": {
        "name": "Debug",
        "tools": {
          "edit_file": true,
          "create_file": false,
          "delete_file": false,
          "rename_file": false,
          "find_file": true,
          "terminal": true,
          "search": true,
          "fetch": true,
          "run_command": true,
          "copy_path": true,
          "move_path": false,
          "open_file": true,
          "go_to_file": true,
          "set_context": true,
          "set_files": true,
          "spawn_agent": true,
          "create_task": false
        },
        "enable_all_context_servers": false,
        "default_model": {
          "provider": "openrouter",
          "model": "z-ai/glm-5.2:free"
        }
      }
    },

    // Разрешения на использование инструментов.
    // "default": "confirm" — запрашивать подтверждение для всех действий по умолчанию.
    // Можно переопределить для конкретных инструментов.
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        // Редактирование файлов — требовать подтверждение.
        "edit_file": { "default": "confirm" },
        // Удаление файлов — требовать подтверждение.
        "delete_path": { "default": "confirm" },
        // Терминал — разрешить по умолчанию, но с ограничениями.
        "terminal": {
          "default": "allow",
          // Команды, которые всегда разрешены без подтверждения.
          "always_allow": [
            {
              "pattern": "^(python|pytest|pip|uv|poetry|docker|docker-compose)\\s+.*"
            },
          ],
          // Команды, которые всегда запрещены.
          "always_deny": [
            {
              "pattern": "^(sudo|su|doas)\\s"
            },
            {
              "pattern": "^rm\\s+-[rf]\\s+/"
            }
          ]
        }
      }
    }
  },

  // ============================================================================
  // ЯЗЫКОВЫЕ МОДЕЛИ
  // ============================================================================

  // Конфигурация провайдеров языковых моделей для AI-функций Zed.
  // Поддерживаются: anthropic, openai, openrouter, ollama, openai_compatible и др.
  "language_models": {
    // OpenAI-совместимые API (включая RouterAI, OpenRouter и другие).
    "openai_compatible": {
      "RouterAI": {
        "api_url": "https://routerai.ru/api/v1",
        "available_models": [
          {
            "name": "anthropic/claude-sonnet-4.6",
            "display_name": "Claude Sonnet 4.6 (RouterAI)",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          },
          {
            "name": "anthropic/claude-haiku-4.5",
            "display_name": "Claude Haiku 4.5 (RouterAI)",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          },
          {
            "name": "google/gemini-3.1-pro-preview",
            "display_name": "Gemini 3.1 Pro (RouterAI)",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          },
          {
            "name": "deepseek/deepseek-v3.2",
            "display_name": "DeepSeek V3.2 (RouterAI)",
            "max_tokens": 100000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 100000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          },
        ]
      }
    },
    // Ollama — локальные модели (требует запущенного ollama serve).
    "ollama": {
      "api_url": "http://localhost:11434"
    },
    // OpenAI API.
    "openai": {
      "api_url": "https://api.openai.com/v1"
    },
    // Anthropic API.
    "anthropic": {
      "api_url": "https://api.anthropic.com"
    }
  },

  // ============================================================================
  // ПРЕДСКАЗАНИЯ РЕДАКТИРОВАНИЯ (Edit Predictions)
  // ============================================================================

  // Настройки AI-предсказаний при редактировании кода.
  // Показывают подсказки, как продолжить код, похожие на GitHub Copilot.
  "edit_predictions": {
    // Провайдер предсказаний: "zed" (встроенный), "copilot" или "none".
    // "zed" — использует встроенную модель Zed, не требует подписки.
    "provider": "copilot",
    // Режим отображения: "subtle" (лёгкие подсказки), "bold" (яркие), "auto".
    "mode": "subtle",
    // Список glob-паттернов, для которых предсказания отключены.
    // Добавляются к стандартному списку Zed.
    "disabled_globs": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/secrets.yml"],
    // Настройки Copilot (если используется).
    "copilot": {
      "enable_next_edit_suggestions": false
    }
  },

  // ============================================================================
  // КЛАВИАТУРНЫЕ КОМБИНАЦИИ
  // ============================================================================

  // Базовая раскладка клавиатурных комбинаций.
  // Варианты: "Zed", "VSCode", "Atom", "JetBrains", "SublimeText", "TextMate", "Emacs", "Cursor", "None".
  // "VSCode" — наиболее привычна для разработчиков, перешедших с VS Code.
  "base_keymap": "JetBrains",

  // Форма курсора в редакторе.
  // "bar" — вертикальная линия (тонкий вертикальный курсор).
  // "block" — блок (удобен в Vim-режиме).
  // "underline" — подчёркивание.
  // "hollow" — пустой блок.
  "cursor_shape": "bar",

  // Как подсвечивать текущую строку.
  // "none" — не подсвечивать.
  // "gutter" — подсветить только gutter.
  // "line" — подсветить область редактора.
  // "all" — подсветить всю строку.
  "current_line_highlight": "line",

  // Показывать ли автоматически сигнатуры функций при наборе.
  // Если включено, сигнатуры показываются при вводе открывающей скобки.
  "auto_signature_help": true,

  // Показывать ли сигнатуры после автодополнения или вставки пары скобок.
  // Если auto_signature_help включён, эта настройка игнорируется.
  "show_signature_help_after_edits": true,

  // Прокрутка за последнюю строку.
  // "one_page" — прокручивать на одну страницу за последней строкой.
  // "vertical_scroll_margin" — прокручивать на величину vertical_scroll_margin.
  // "off" — не прокручивать за последнюю строку.
  "scroll_beyond_last_line": "off",

  // Режим рендеринга текста.
  // "subpixel" — субпиксельный рендеринг (повышает чёткость на LCD-экранах).
  // "lcd" — оптимизирован для LCD-дисплеев.
  // "crisp" — чёткий рендеринг без субпиксельной оптимизации.
  // "monochrome" — монохромный рендеринг.
  "text_rendering_mode": "subpixel",

  // ============================================================================
  // АВТОДОПОЛНЕНИЕ
  // ============================================================================

  "completions": {
    // Как использовать слова из файла для автодополнения.
    // "enabled" — всегда запрашивать слова из файла.
    // "fallback" — использовать слова только если LSP не ответил.
    // "disabled" — не использовать слова из файла.
    "words": "fallback",

    // Минимальная длина запроса для word-based автодополнения.
    // Чем меньше, тем раньше появляются подсказки.
    "words_min_length": 2,

    // Как заменять текст при выборе автодополнения из LSP.
    // "insert" — вставлять текст перед курсором.
    // "replace" — заменять текст до и после курсора.
    // "replace_subsequence" — заменять, если текст является подпоследовательностью.
    // "replace_suffix" — заменять суффикс после курсора.
    "lsp_insert_mode": "replace_suffix"
  },

  // ============================================================================
  // ОТОБРАЩЕНИЕ ТЕКСТА
  // ============================================================================

  // Как отображать пробельные символы.
  // "all" — показывать все пробелы и табы.
  // "selection" — показывать только в выделенном тексте.
  // "none" — не показывать.
  // "boundary" — показывать только на границах строк.
  "show_whitespaces": "selection",

  // Предпочтительная длина строки для переноса.
  // Используется для soft_wrap и wrap_guides.
  // 88 — стандарт Black для Python.
  // 120 — часто используется в enterprise-проектах.
  "preferred_line_length": 120,

  // Вертикальные направляющие (wrap guides).
  // Помогают визуально контролировать длину строк.
  "wrap_guides": [120],

  // Раскрашивать скобки разными цветами (rainbow brackets).
  // Улучшает читаемость вложенных структур.
  "colorize_brackets": true,

  // Настройки направляющих отступов (indent guides).
  "indent_guides": {
    // Цветовое затемнение фона между уровнями отступов.
    // "disabled" — не затемнять.
    // "indent_aware" — затемнять с учётом уровня вложенности (радужная индикация).
    "background_coloring": "disabled",
    // Цветовая схема направляющих.
    // "fixed" — один цвет для всех уровней.
    // "indent_aware" — разные цвета для разных уровней (радужная индикация).
    "coloring": "indent_aware"
  },

  // Использовать ли дополнительные LSP-запросы для форматирования при вводе.
  // Может конфликтовать с Ruff/Pyright. Отключено для стабильности.
  "use_on_type_format": false,

  // ============================================================================
  // ПАНЕЛЬ ПРОЕКТА
  // ============================================================================

  "project_panel": {
    // Открывать панель проекта при запуске.
    "starts_open": true,

    // Автоматически раскрывать текущий файл в панели проекта.
    "auto_reveal_entries": true,

    // Скрывать файлы из .gitignore в панели проекта.
    "hide_gitignore": false,

    // Автоматически открывать файлы после создания/вставки.
    "auto_open": {
      "on_paste": true,
      "on_create": true
    },

    // Скрывать корневую директорию проекта.
    "hide_root": false,

    // Позиция панели: "left" или "right".
    "dock": "left",

    // Скрывать скрытые файлы (начинающиеся с .).
    "hide_hidden": false,

    // Жирные названия папок.
    "bold_folder_labels": false,

    // Показывать диагностические значки на файлах.
    "diagnostic_badges": true,

    // Показывать статус Git в панели проекта.
    "git_status_indicator": true,

    // Автоматически складывать директории с одной вложенной папкой.
    "auto_fold_dirs": false,

    // Показывать иконки папок.
    "folder_icons": true,

    // Показывать иконки файлов.
    "file_icons": true,

    // Интервал между элементами: "comfortable" или "standard".
    "entry_spacing": "comfortable",

    // Ширина панели по умолчанию (в пикселях).
    "default_width": 240,

    // Способ сортировки: "directories_first", "mixed", "files_first".
    "sort_mode": "directories_first",

    // Порядок сортировки: "default", "upper", "lower", "unicode".
    "sort_order": "default",

    // Размер отступа для вложенных элементов (в пикселях).
    "indent_size": 20,

    // Показывать sticky scroll (плавающие заголовки секций).
    "sticky_scroll": true,

    // Показывать диагностику в панели проекта: "all", "errors", "off".
    "show_diagnostics": "all",

    // Настройки направляющих отступов в панели проекта.
    "indent_guides": {
      "show": "always"
    }
  },

  // ============================================================================
  // ВКЛАДКИ (TABS)
  // ============================================================================

  "tabs": {
    // Показывать статус Git на вкладках.
    "git_status": true,

    // Показывать иконки файлов на вкладках.
    "file_icons": true,

    // Показывать диагностические индикаторы: "off", "errors", "all".
    "show_diagnostics": "errors",

    // Поведение кнопки закрытия: "hover", "always", "hidden".
    "show_close_button": "always",

    // Позиция кнопки закрытия: "left" или "right".
    "close_position": "right",

    // Что делать после закрытия вкладки: "history", "neighbour", "left_neighbour".
    "activate_on_close": "history"
  },

  // ============================================================================
  // PREVIEW-ВКЛАДКИ
  // ============================================================================

  // Preview-вкладки позволяют быстро просматривать файлы без создания постоянных вкладок.
  // Они закрываются при переключении на другой файл, если не закреплены.
  "preview_tabs": {
    // Открывать как preview из file finder.
    "enable_preview_from_file_finder": true,
    // Открывать как preview из панели проекта.
    "enable_preview_from_project_panel": true,
    // Открывать как preview из мультibuffer.
    "enable_preview_from_multibuffer": true,
    // Открывать как preview при навигации по коду.
    "enable_preview_file_from_code_navigation": true,
    // Сохранять preview-вкладку при навигации по коду.
    "enable_keep_preview_on_code_navigation": false
  },

  // ============================================================================
  // СКРОЛЛБАР
  // ============================================================================

  "scrollbar": {
    // Когда показывать скроллбар: "auto", "system", "always", "never".
    "show": "auto",

    // Какие диагностические маркеры показывать: "all", "none", "error", "warning", "information".
    "diagnostics": "information",

    // Показывать позиции курсоров других участников.
    "cursors": true,

    // Показывать маркеры git diff.
    "git_diff": true,

    // Показывать результаты поиска.
    "search_results": true,

    // Показывать выделенный текст.
    "selected_text": true,

    // Показывать выделенные символы.
    "selected_symbol": true,

    // Оси скроллбара.
    "axes": {
      "horizontal": true,
      "vertical": true
    }
  },

  // ============================================================================
  // МИНИМАП
  // ============================================================================

  // Минимап — обзорный экран документа в правом углу редактора.
  "minimap": {
    // Когда показывать: "always", "auto", "never".
    "show": "never"
  },

  // ============================================================================
  // ПОИСК И НАВИГАЦИЯ
  // ============================================================================

  // Что делать, если go to definition не нашёл определение.
  // "none" — ничего не делать.
  // "find_all_references" — найти все ссылки на символ.
  "go_to_definition_fallback": "find_all_references",

  // Умный поиск с учётом регистра.
  // Если запрос содержит заглавные буквы — поиск становится чувствительным к регистру.
  "use_smartcase_search": true,

  // Использовать ли выделенный текст как начальный запрос поиска.
  // "always" — всегда использовать слово под курсором.
  // "selection" — использовать только выделенный текст.
  // "never" — не использовать.
  "seed_search_query_from_cursor": "selection",

  "search": {
    // Центрировать строку с совпадением в окне при переходе к ней.
    "center_on_match": true,

    // Показывать кнопку поиска в статус-баре.
    "button": true,

    // Искать только целые слова.
    "whole_word": false,

    // Чувствительный поиск к регистру.
    "case_sensitive": false,

    // Включать игнорируемые файлы (gitignore) в поиск.
    "include_ignored": false,

    // Использовать регулярные выражения в поиске.
    "regex": false
  },

  // Переносить ли результаты поиска через конец файла.
  "search_wrap": true,

  // ============================================================================
  // СЕМАНТИЧЕСКИЕ ТОКЕНЫ И СИМВОЛЫ
  // ============================================================================

  // Использовать ли семантические токены LSP для подсветки синтаксиса.
  // "off" — только tree-sitter.
  // "combined" — tree-sitter + LSP (рекомендуется).
  // "full" — только LSP.
  "semantic_tokens": "combined",

  // Использовать ли LSP для отображения структуры файла.
  // "off" — использовать tree-sitter.
  // "on" — использовать LSP (более точные символы для сложных конструкций).
  "document_symbols": "on",

  // Использовать ли LSP для сворачивания диапазонов кода.
  // "off" — использовать tree-sitter и indent-based folding.
  // "on" — использовать LSP, с fallback на tree-sitter.
  "document_folding_ranges": "on",

  // Максимальный уровень диагностики для отображения.
  // null — показывать все.
  // "error", "warning", "info", "hint" — фильтр по уровню.
  "diagnostics_max_severity": null,

  // ============================================================================
  // ДИАГНОСТИКА
  // ============================================================================

  "diagnostics": {
    // Показывать кнопку диагностики в статус-баре.
    "button": true,

    // Включать ли предупреждения по умолчанию.
    "include_warnings": true,

    // Inline-диагностика (отображение ошибок справа от строки).
    "inline": {
      // Включить inline-диагностику.
      "enabled": true,

      // Задержка обновления диагностики в мс.
      "update_debounce_ms": 150,

      // Отступ между концом строки и диагностикой.
      "padding": 4,

      // Минимальная колонка для отображения inline-диагностики.
      "min_column": 120,

      // Максимальный уровень диагностики для inline: "error", "warning", "info", "hint", null.
      "max_severity": "warning"
    }
  },

  // ============================================================================
  // СТАТУС-БАР
  // ============================================================================

  "status_bar": {
    // Кнопка переключения окончаний строк (LF / CRLF).
    "line_endings_button": true
  },

  // ============================================================================
  // INLAY HINTS
  // ============================================================================

  // Inlay hints — дополнительная информация inline в коде (типы параметров, типы переменных и т.д.).
  // Предварительно настроены для: Go, Rust, TypeScript, Svelte.
  "inlay_hints": {
    // Включить inlay hints.
    "enabled": true,

    // Показывать ли типы переменных.
    "show_type_hints": true,

    // Показывать ли имена параметров при вызове функций.
    "show_parameter_hints": true,

    // Показывать ли другие hints (константы, переменные и т.д.).
    "show_other_hints": true,

    // Фон для inlay hints.
    "show_background": false,

    // Задержка обновления hints при редактировании (в мс).
    "edit_debounce_ms": 700,

    // Задержка обновления hints при прокрутке (в мс).
    "scroll_debounce_ms": 50,

    // Переключать hints при нажатии модификатора.
    "toggle_on_modifiers_press": {
      "platform": true
    }
  },

  // ============================================================================
  // НАСТРОЙКИ ЯЗЫКОВ
  // ============================================================================

  // Языковые-специфичные настройки. Переопределяют глобальные настройки для конкретного языка.
  "languages": {
    // JSON — форматирование через Prettier.
    "JSON": {
      "prettier": {
        "allowed": true,
        "parser": "json"
      },
      "always_treat_brackets_as_autoclosed": true,
      "indent_guides": {
        "background_coloring": "disabled"
      },
      "use_on_type_format": true,
      "tab_size": 2,
      "hard_tabs": false
    },

    // TOML — отключаем Prettier для совместимости с Ruff.
    "TOML": {
      "format_on_save": "off",
      "prettier": {
        "allowed": false
      }
    },

    // Python — основной язык для backend-разработки.
    "Python": {
      // Комбинированное использование tree-sitter и LSP для подсветки.
      "semantic_tokens": "combined",

      // Языковые серверы: basedpyright для типизации, ruff для линтера и форматтера.
      "language_servers": ["basedpyright", "ruff"],

      // Форматирование при сохранении.
      "format_on_save": "on",

      // Действия при форматировании (через Ruff).
      "code_actions_on_format": {
        // Сортировка импортов.
        "source.organizeImports.ruff": true,
        // Автоматическое исправление ошибок.
        "source.fixAll.ruff": true
      },

      // Форматтер — через Ruff language server.
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },

      // Отступы: 4 пробела (PEP 8).
      "tab_size": 4,
      "hard_tabs": false,

      // Длина строки: 88 (стандарт Black).
      "preferred_line_length": 88,

      // Перенос строк по preferred_line_length.
      "soft_wrap": "bounded",

      // Отображение пробельных символов.
      "show_whitespaces": "none",

      // Направляющие отступов.
      "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "indent_aware"
      },

      // Inlay hints для Python.
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true
      }
    },

    // Docker — настройки для Docker-файлов.
    "Dockerfile": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": false
    },

    // YAML — настройки для YAML-файлов.
    "YAML": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false
    },

    // SQL — настройки для SQL-файлов.
    "SQL": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": false,
      "preferred_line_length": 120
    },

    // Markdown — настройки для Markdown-файлов.
    "Markdown": {
      "format_on_save": "off",
      "preferred_line_length": 80,
      "soft_wrap": "bounded"
    },

    // Shell Script — настройки для shell-скриптов.
    "Shell Script": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false
    }
  },

  // ============================================================================
  // ГЛОБАЛЬНЫЕ НАСТРОЙКИ LSP
  // ============================================================================

  // Глобальные настройки для всех языковых серверов.
  "global_lsp_settings": {
    // Показывать кнопку статуса LSP в статус-баре.
    "button": true,

    // Таймаут запросов LSP в секундах.
    "request_timeout": 120,

    // Максимальная длина строки для обработки LSP.
    "max_buffer_line_length": 20000,

    // Настройки уведомлений LSP.
    "notifications": {
      // Время автоматического закрытия уведомлений (в мс).
      "dismiss_timeout_ms": 5000
    }
  },

  // ============================================================================
  // НАСТРОЙКИ ЯЗЫКОВЫХ СЕРВЕРОВ (LSP)
  // ============================================================================

  // Конфигурация конкретных языковых серверов.
  "lsp": {
    // Codebook — язык сервер для документации и объяснения кода.
    "codebook": {
      "initialization_options": {
        "diagnosticSeverity": "hint"
      }
    },

    // Ruff — линтер и форматтер для Python.
    "ruff": {
      "initialization_options": {
        "settings": {
          // Предпочитать настройки редактора, если они заданы.
          "configurationPreference": "editorFirst",

          // Показывать синтаксические ошибки.
          "showSyntaxErrors": true,

          // Длина строки для линтера.
          "lineLength": 120,

          // Правила линтера.
          "lint": {
            // Включённые правила:
            // E, W — стилистические ошибки (pycodestyle)
            // F — ошибки Pyflakes
            // I — сортировка импортов
            // B — правила безопасности (flake8-bugbear)
            // C4 — оптимизация (flake8-comprehensions)
            // SIM — упрощения (flake8-simplify)
            // UP — модернизация (pyupgrade)
            // N — именование (pep8-naming)
            // ANN — аннотации типов (flake8-annotations)
            // D — документация (pydocstyle)
            "select": ["E4", "E7", "E9", "F", "I"],
            // Игнорируемые правила:
            // E501 — слишком длинная строка (отключено, используем lineLength)
            "ignore": ["E501"]
          }
        }
      }
    },

    // BasedPyright — типизированный язык сервер для Python.
    "basedpyright": {
      "settings": {
        "python.analysis": {
          // Режим диагностики: "openFilesOnly" или "workspace".
          "diagnosticMode": "workspace",

          // Режим проверки типов: "off", "basic", "standard", "strict".
          "typeCheckingMode": "basic",

          // Автоматически искать пути для импортов.
          "autoSearchPaths": true,

          // Включить автодополнение импортов.
          "autoImportCompletions": true,

          // Использовать код библиотек для извлечения типов.
          "useLibraryCodeForTypes": true
        }
      }
    }
  },

  // ============================================================================
  // ТЕРМИНАЛ
  // ============================================================================

  "terminal": {
    // Показывать ли счётчик терминалов в статус-баре.
    "show_count_badge": true,

    // Автоматическое обнаружение и активация виртуальных окружений Python.
    "detect_venv": {
      "on": {
        // Директории для поиска виртуальных окружений.
        "directories": [".venv", "venv", ".env", "env", ".pypoetry", ".hatch"],
        // Скрипт активации: "default", "csh", "fish", "nushell".
        "activate_script": "default"
      }
    },

    // Переменные окружения для терминала.
    "env": {
      // Использовать Zed в качестве редактора для git commit.
      "EDITOR": "zed --wait"
    }
  },

  // ============================================================================
  // ПРИВАТНЫЕ ФАЙЛЫ
  // ============================================================================

  // Скрывать значения переменных в приватных файлах.
  "redact_private_values": false,

  // ============================================================================
  // ОТЛАДЧИК
  // ============================================================================

  "debugger": {
    // Позиция панели отладчика: "bottom", "left", "right".
    "dock": "bottom",

    // Гранулярность шагов: "line", "statement", "instruction".
    "stepping_granularity": "line"
  },

  // ============================================================================
  // АВТООБНОВЛЕНИЕ РАСШИРЕНИЙ
  // ============================================================================

  // Автоматически обновлять расширения.
  "auto_update_extensions": {
    "colored-zed-icons-theme": true
  },

  // ============================================================================
  // ТЕЛЕМЕТРИЯ
  // ============================================================================

  "telemetry": {
    // Отправлять ли диагностические данные (crash reports).
    "diagnostics": false,
    // Отправлять ли анонимизированные метрики использования.
    "metrics": false
  },

  // ============================================================================
  // GIT
  // ============================================================================

  "git": {
    // Инлайн blame — показ информации о коммите рядом со строкой.
    "inline_blame": {
      // Показывать краткое описание коммита.
      "show_commit_summary": true
    },
    // Показывать git gutter только для отслеживаемых файлов.
    "git_gutter": "tracked_files"
  },

  // ============================================================================
  // ПАНЕЛЬ GIT
  // ============================================================================

  // Настройки панели Git для просмотра статуса репозитория и выполнения коммитов.
  "git_panel": {
    // Способ сортировки: "name" или "path".
    "sort_by": "name",
    // Группировка: "status" или "none".
    "group_by": "status",
    // Позиция панели: "left" или "right".
    "dock": "left",
    // Показывать счётчик в статус-баре.
    "show_count_badge": true,
    // Показывать иконки файлов.
    "file_icons": true,
    // Древовидый вид.
    "tree_view": false,
    // Сворачивать незатрекенные файлы в diff.
    "collapse_untracked_diff": false
  },

  // ============================================================================
  // СТИЛЬ ДИФФА
  // ============================================================================

  // Как отображать изменения: "split" (две панели) или "unified" (inline).
  "diff_view_style": "split",

  // ============================================================================
  // Which Key
  // ============================================================================

  // Which Key — всплывающая подсказка доступных команд при удержании префикса.
  "which_key": {
    "enabled": true
  },

  // ============================================================================
  // СЕССИЯ
  // ============================================================================

  // Разрешить открывать несколько worktrees одного репозитория одновременно.
  "session": {
    "trust_all_worktrees": true
  },

  // ============================================================================
  // ТЕМА И ШРИФТЫ
  // ============================================================================

  // Тема иконок файлов.
  "icon_theme": "Material Icon Theme",

  // Цветовая тема интерфейса.
  "theme": "One Dark PyCharm Comfort",

  // Шрифт интерфейса.
  "ui_font_family": ".ZedSans",

  // Размер шрифта интерфейса.
  "ui_font_size": 15,

  // Размер шрифта кода.
  "buffer_font_size": 13,

  // Межстрочный интервал.
  "buffer_line_height": {
    "custom": 2.0
  }
}
